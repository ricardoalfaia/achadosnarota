# Modelo das variáveis do Meuproduto Web. Toda variável nova entra primeiro aqui,
# depois em .env.homolog, .env.production e no schema de src/shared/config/ambiente.ts.
# `pnpm check:env` falha quando as chaves divergem.
#
# Para desenvolver: copie este arquivo para .env.local e preencha BETTER_AUTH_SECRET.
# Segredos nunca entram em arquivo versionado; ficam em .env.local ou no pipeline.
# DATABASE_URL_ADMIN (dono das tabelas) NUNCA entra aqui: o app recusa subir com ela.

# Ambiente lógico: local | homolog | production. Vai para o bundle do navegador.
NEXT_PUBLIC_APP_ENV=local

# URL pública do app (sem barra no fim). Base do Better Auth, origem confiável e
# base dos links enviados por e-mail. https liga os cookies Secure.
APP_URL=http://localhost:4400

# Conexão do app ao Postgres como meuproduto_app, papel que não é dono das tabelas
# e por isso fica sujeito ao RLS (ADR-0020). Em dev, o do docker-compose.
DATABASE_URL=postgresql://meuproduto_app:meuproduto_app@127.0.0.1:4450/meuproduto

# Segredo do Better Auth (assinatura de cookies e cifra do segredo do 2FA).
# Segredo: vazio aqui e nos arquivos versionados. Mínimo de 32 caracteres.
# Gere com: openssl rand -base64 48. Trocar encerra as sessões e invalida o 2FA.
BETTER_AUTH_SECRET=

# Cadastro público (true | false). Vazio ou false: fechado, só por convite ou bootstrap.
SIGNUP_ENABLED=false

# Remetente dos e-mails transacionais (redefinição de senha).
EMAIL_FROM=Meuproduto <nao-responda@meuproduto.com.br>
# Chave da API do Resend. Sem ela: em local, o e-mail sai no console do servidor;
# fora do local, o envio falha com erro claro. Segredo: vazio nos versionados.
RESEND_API_KEY=
# Só para o E2E: arquivo onde os e-mails são gravados em vez de enviados. Só vale
# com APP_URL em 127.0.0.1/localhost. Deixe vazio em qualquer outro uso.
EMAIL_CAIXA_DE_TESTE=
