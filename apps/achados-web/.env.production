# Produção. Versionado: somente valores sem segredo.
# Carregado pelo Next em `next build` e `next start`.
NEXT_PUBLIC_APP_ENV=production
# A definir: o endereço de produção ainda não existe (placeholder).
APP_URL=https://achados.achados.com.br
# A conexão real (com senha) vem do pipeline; vazio aqui de propósito.
DATABASE_URL=

# Segredos: o valor vem do pipeline, nunca deste arquivo.
BETTER_AUTH_SECRET=
SIGNUP_ENABLED=true
EMAIL_FROM=Achados na Rota <nao-responda@achados.com.br>
RESEND_API_KEY=
EMAIL_CAIXA_DE_TESTE=`

R2_ACCOUNT_ID=
R2_API_KEY=
R2_TOKEN=
R2_SECRET=
R2_BUCKET=
R2_PUBLIC_URL=

# Stripe (ADR-006 de produto): cartão e Pix no Checkout; a assinatura só ativa
# pelo webhook assinado. Todas ou nenhuma; sem elas, "Assinar" fica
# indisponível. Segredos: vazios aqui e nos versionados.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Conexão como achados_pagamentos (só o webhook usa; escreve assinaturas).
# Em dev: postgresql://achados_pagamentos:achados_pagamentos@127.0.0.1:4550/achados
DATABASE_URL_PAGAMENTOS=
