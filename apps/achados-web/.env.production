# Produção. Versionado: somente valores sem segredo.
# Carregado pelo Next em `next build` e `next start`.
NEXT_PUBLIC_APP_ENV=production
# A definir: o endereço de produção ainda não existe (placeholder).
APP_URL=https://app.achados.com.br
# A conexão real (com senha) vem do pipeline; vazio aqui de propósito.
DATABASE_URL=

# Segredos: o valor vem do pipeline, nunca deste arquivo.
BETTER_AUTH_SECRET=
SIGNUP_ENABLED=true
EMAIL_FROM=Achados na Rota <nao-responda@achados.com.br>
RESEND_API_KEY=
EMAIL_CAIXA_DE_TESTE=
