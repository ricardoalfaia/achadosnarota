# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files: exemplo, homolog e production são versionados sem segredos
.env*
!.env.example
!.env.homolog
!.env.production

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# sessão gravada pelo E2E
/e2e/.auth/

# caixa de e-mail gravada pelo E2E
/e2e/saida/
