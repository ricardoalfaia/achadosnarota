# Homologação. Versionado: somente valores sem segredo.
# Carregado por `pnpm build:homolog` e `pnpm start:homolog`.
NEXT_PUBLIC_APP_ENV=homolog
# A definir: o endereço de homologação ainda não existe (placeholder).
APP_URL=https://homolog.achados.com.br
# A conexão real (com senha) vem do pipeline; vazio aqui de propósito.
DATABASE_URL=

# Segredos: o valor vem do pipeline, nunca deste arquivo.
BETTER_AUTH_SECRET=
SIGNUP_ENABLED=true
EMAIL_FROM=Achados na Rota <nao-responda@achados.com.br>
RESEND_API_KEY=
EMAIL_CAIXA_DE_TESTE=

# Cloudflare R2 (ver .env.example). Segredos no pipeline.
R2_ACCOUNT_ID=
R2_API_KEY=
R2_TOKEN=
R2_SECRET=
R2_BUCKET=
R2_PUBLIC_URL=
