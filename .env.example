# Variáveis do banco para os scripts da raiz e do @meuproduto/db
# (drizzle-kit, seed, bootstrap, setup do papel da app, testes de integração).
#
# Copie para .env.local NA RAIZ só se precisar mudar algo: sem .env.local, o
# carregador (scripts/load-env.mjs) usa exatamente estes valores de dev, que
# apontam para o Postgres do docker-compose (pnpm infra:up).
# Variável já definida no processo (CI, pipeline) vence o arquivo.
# Segredo de produção NUNCA entra em arquivo versionado: vem do ambiente.
# As variáveis do app web ficam em apps/meuproduto-web/.env.example.

# Papel da aplicação (meuproduto_app): não é dono das tabelas, sujeito a RLS.
# É o que o app e os testes de isolamento usam.
DATABASE_URL=postgresql://meuproduto_app:meuproduto_app@127.0.0.1:4450/meuproduto

# Dono do schema (meuproduto): só migrations, seed e bootstrap. Nunca no app.
DATABASE_URL_ADMIN=postgresql://meuproduto:meuproduto@127.0.0.1:4450/meuproduto
