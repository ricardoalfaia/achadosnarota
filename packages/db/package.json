{
  "name": "@meuproduto/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts"
  },
  "scripts": {
    "lint": "eslint src scripts --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integracao": "node ../../scripts/with-env.mjs --exigir-banco -- vitest run",
    "db:generate": "node ../../scripts/with-env.mjs -- drizzle-kit generate",
    "db:migrate": "node ../../scripts/with-env.mjs -- drizzle-kit migrate",
    "db:studio": "node ../../scripts/with-env.mjs -- drizzle-kit studio",
    "db:seed": "node ../../scripts/with-env.mjs -- tsx src/seed.ts",
    "db:setup-app-role": "node ../../scripts/with-env.mjs -- node scripts/setup-app-role.mjs",
    "bootstrap": "node ../../scripts/with-env.mjs -- tsx src/bootstrap.ts"
  },
  "dependencies": {
    "@meuproduto/core": "workspace:*",
    "drizzle-orm": "0.45.3",
    "postgres": "3.4.9"
  },
  "devDependencies": {
    "@meuproduto/eslint-config": "workspace:*",
    "@meuproduto/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "better-auth": "1.7.5",
    "drizzle-kit": "0.31.11",
    "eslint": "catalog:",
    "tsx": "4.23.15",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
